# ── 本地开发配置模板 ──────────────────────────────
# 复制为 .env.local 并按需填写。.env.local 已被 gitignore，不会入库。

# ── LLM（agent 研究助手问答，必填）────────────────
# DeepSeek 或其他 OpenAI 兼容 API key，二选一即可
LLM_API_KEY=
# DEEPSEEK_API_KEY=

# ── LLM 可选参数（均有默认值，不配也能跑）─────────
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
# LLM_TEMPERATURE=
# LLM_MAX_TOKENS=
# LLM_TIMEOUT_MS=
# LLM_INPUT_PRICE=
# LLM_OUTPUT_PRICE=
# LLM_PRICE_CURRENCY=

# ── 数据库（本地零配置，以下均可不填）─────────────
# 默认使用项目根目录的 news_archive.db；也可在「设置 → 数据与存储」切换（重启生效）。
# 解析顺序：DB_BACKEND → Vercel → 设置页（db-config.json）→ 本地文件。
# 显式设置 DB_BACKEND 会覆盖并锁定设置页的切换。
# DB_BACKEND=local
# 部署时强制远端（Vercel 未设置时也默认走 Turso）：
# DB_BACKEND=turso
# TURSO_DATABASE_URL=libsql://xxx.turso.io
# TURSO_AUTH_TOKEN=
# 注意：只填 TURSO_DATABASE_URL 不会切换远端，必须同时设 DB_BACKEND=turso 或部署在 Vercel。
# NEWS_DB_PATH=/absolute/path/to/news_archive.db
# 设置页写入的后端选择文件（默认与 news_archive.db 同目录；自托管需可写持久盘）
# DB_CONFIG_PATH=/absolute/path/to/db-config.json

# ── 个人投研驾驶舱（财经信号）────────────────────
# Tushare Pro 行情凭证（也可在应用内「设置 → 数据与存储」填写）。
# 仅用于 T1 行情/日历；官方公告与政策走交易所、巨潮、证监会公开页面。
# TUSHARE_TOKEN=
# 演示模式：写入带“示例”标注的行情、公告和简报，仅用于验证界面与流程。
# 不要在生产数据库上开启；含示例数据的库会拒绝接入真实行情。
# COCKPIT_DEMO=1

# 交易时段自动抓取：A 股盘中每分钟、美股时段每 15 分钟、16:10 排队收盘入库与分析。
# 本地文件库默认开启；设为 0 关闭（测试/构建/Vercel/演示模式本就不启用）。
# COCKPIT_LIVE_SCHEDULER=0

# ── 付费行情/快讯快照（可选，默认关闭）────────────
# 配置后收盘刷新会额外 GET 一次 JSON；未配置时不发任何请求。
# 响应每条行情/快讯必须带 delaySeconds（非负整数），缺失或字段无效的条目会被丢弃；
# 界面只展示「延迟 N 秒」，延迟数据永远不会被标成实时。
# 响应示例：{"quotes":[{"code":"600519.SH","name":"贵州茅台","price":1700.5,
#   "previousClose":1690,"changePct":0.62,"tradeTime":"2026-11-14T14:30:00+08:00","delaySeconds":15}],
#   "news":[{"id":"n-1","title":"…","publishedAt":"…","url":"…","summary":"…","delaySeconds":60}]}
# REALTIME_SOURCE_URL=
# REALTIME_SOURCE_TOKEN=

# ── AKShare 侧车（可选，T2 补充）──────────────────
# 需在本机另起 integrations/akshare 的 Python 服务；两项都填才会启用。
# 任务只补自选/持仓日线与涨停池，已存在的 T0/T1 行情不会被覆盖。
# AKSHARE_SIDECAR_URL=http://127.0.0.1:8765
# AKSHARE_SIDECAR_TOKEN=

# ── 其他可选 ──────────────────────────────────────
# 数据源覆盖（默认抓取内置源列表）
# NEWS_SOURCES=
# 分析管线批处理调参
# PIPELINE_BATCH_SIZE=
# PIPELINE_MAX_BATCHES=
# QStash cron 鉴权（生产定时任务）
# CRON_SECRET=
# 站点 URL（默认 localhost:3000）
# SITE_URL=
# NEXT_PUBLIC_BASE_URL=
# ── 首启账号（生产建议显式配置；不配则随机生成并打印到服务端日志一次）──
# ADMIN_INITIAL_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=
