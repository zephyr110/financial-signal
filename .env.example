# ── 本地开发配置模板 ──────────────────────────────
# 复制为 .env.local 并按需填写。.env.local 已被 gitignore，不会入库。

# ── LLM（agent 研究助手问答，必填）────────────────
# DeepSeek 或其他 OpenAI 兼容 API key，二选一即可
LLM_API_KEY=
# DEEPSEEK_API_KEY=

# ── LLM 可选参数（均有默认值，不配也能跑）─────────
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
# LLM_TEMPERATURE=
# LLM_MAX_TOKENS=
# LLM_TIMEOUT_MS=
# LLM_INPUT_PRICE=
# LLM_OUTPUT_PRICE=
# LLM_PRICE_CURRENCY=

# ── 数据库（本地零配置，以下均可不填）─────────────
# 默认使用项目根目录的 news_archive.db
# NEWS_DB_PATH=/absolute/path/to/news_archive.db
# 生产（Vercel）才需要 Turso 远端库：
# TURSO_DATABASE_URL=libsql://xxx.turso.io
# TURSO_AUTH_TOKEN=

# ── 其他可选 ──────────────────────────────────────
# 数据源覆盖（默认抓取内置源列表）
# NEWS_SOURCES=
# 分析管线批处理调参
# PIPELINE_BATCH_SIZE=
# PIPELINE_MAX_BATCHES=
# QStash cron 鉴权（生产定时任务）
# CRON_SECRET=
# 站点 URL（默认 localhost:3000）
# SITE_URL=
# NEXT_PUBLIC_BASE_URL=
# ── 首启账号（生产建议显式配置；不配则随机生成并打印到服务端日志一次）──
# ADMIN_INITIAL_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=
