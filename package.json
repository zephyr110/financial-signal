{
  "name": "financial-signal",
  "version": "2.0.0",
  "description": "新浪全球实时财经新闻 RSS — Next.js + ISR 自动更新",
  "private": true,
  "main": "electron/main.js",
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:desktop": "cross-env DESKTOP_MODE=1 concurrently -k -n web,app \"next dev --webpack -p 3010 -H 127.0.0.1\" \"electron .\"",
    "build:desktop": "node scripts/ci-seed-db.mjs && cross-env NEWS_DB_PATH=./seed/news_archive.db pnpm build && node scripts/copy-standalone.mjs && electron-builder",
    "dist:dir": "node scripts/ci-seed-db.mjs && cross-env NEWS_DB_PATH=./seed/news_archive.db pnpm build && node scripts/copy-standalone.mjs && electron-builder --dir",
    "prebuild": "node scripts/verify-data.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepare": "husky",
    "icons": "python3 scripts/generate-icons.py",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@libsql/client": "^0.17.4",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "feed": "^4.2.1",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^1.25.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.0",
    "remark-gfm": "^4.0.1",
    "styled-jsx": "^5.1.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.10",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.22",
    "shadcn": "^3.8.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
